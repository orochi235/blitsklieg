{
  "extends": "../../tsconfig.base.json",
  // The build state lives in the directory it describes, so deleting dist really does force a
  // rebuild rather than leaving tsc -b convinced the missing output is current.
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"]
}
